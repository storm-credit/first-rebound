  "facts": [
    {
      "id": "F01",
      "source_ids": [
        "S1"
      ],
      "classification": "FACT",
      "statement_ko": "학생선수 정의는 학교운동부 소속·운동 또는 해당 체육단체 등록·선수활동이다. 단체등록만이 유일한 요건은 아니다.",
      "locator": "제2조제4호"
    },
    {
      "id": "F02",
      "source_ids": [
        "S1"
      ],
      "classification": "FACT",
      "statement_ko": "2013시행 법 제11조제1항은 별도 기초학력보장 프로그램과 최저학력 보장 노력, 필요한 경우 경기대회 출전 제한의 구조다.",
      "locator": "제11조제1항 및 제2항"
    },
    {
      "id": "F03",
      "source_ids": [
        "S2"
      ],
      "classification": "FACT",
      "statement_ko": "지도자 직무는 훈련계획·지도관리, 대회 지원·인솔, 경기력 분석·훈련일지, 훈련장 안전이다.",
      "locator": "제3조제3항"
    },
    {
      "id": "F04",
      "source_ids": [
        "S3"
      ],
      "classification": "FACT",
      "statement_ko": "당시 시행규칙은 매 학기말 고등학생선수3교과, 학교·학년 각교과 평균의30%, 보장프로그램 학기60시간, 교육감 세부운영을 정한다.",
      "locator": "시행규칙 제6조; 인쇄278–279 / PDF219–220"
    },
    {
      "id": "F05",
      "source_ids": [
        "S4"
      ],
      "classification": "FACT",
      "statement_ko": "2015계획의 실제 적용 범위는 2015-03-01부터 초4~고1이며, 고2는2016/고3는2017 확대단계다.",
      "locator": "인쇄26 / PDF28"
    },
    {
      "id": "F06",
      "source_ids": [
        "S4"
      ],
      "classification": "FACT",
      "statement_ko": "계획의 제한·해제 예시는 선수등록 가능을 대회출전 제한과 따로 명시한다. 법정 보충 수료와 출결·학습 확인은 대회 허용 절차의 별도 조건이다.",
      "locator": "인쇄27 / PDF29"
    },
    {
      "id": "F07",
      "source_ids": [
        "S4"
      ],
      "classification": "FACT",
      "statement_ko": "학교운동부 운영계획은 학교장 수립과 학교운영위원회 심의, 정규수업 이외 운동 원칙을 명시한다. 특정 시설 부재 종목의 체험학습·결재 예외는 농구에 자동 적용되지 않는다.",
      "locator": "인쇄25·30 / PDF27·32"
    },
    {
      "id": "F08",
      "source_ids": [
        "S3"
      ],
      "classification": "FACT",
      "statement_ko": "학칙에 교과·수업일수·고사·과정수료 인정 및 학교생활 사항을 기재한다.",
      "locator": "초중등 시행령 제9조; 인쇄86–87 / PDF74–75"
    },
    {
      "id": "F09",
      "source_ids": [
        "S3"
      ],
      "classification": "FACT",
      "statement_ko": "교외체험학습의 수업 인정은 교육상 필요·보호자 동의·학교장 허가·학칙 범위의 구조다. 과정수료 출석은 수업일수2/3 이상이다.",
      "locator": "초중등 시행령 제48조제5항·제50조제2항; 인쇄99 / PDF87"
    }
  ],
